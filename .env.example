# ==========================================
# Firebase Client Configuration (Frontend)
# Found in: Firebase Console -> Project Settings -> General -> Your apps -> Web app
# ==========================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ==========================================
# Firebase Admin SDK (Backend / Server)
# Found in: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
# ==========================================
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ==========================================
# Google Gemini AI API Key (AI Timetable & Audio)
# ==========================================
NEXT_PUBLIC_GEMINI_API_KEY=

# Optional extra Gemini keys for key rotation
# NEXT_PUBLIC_GEMINI_API_KEY_2=
# NEXT_PUBLIC_GEMINI_API_KEY_3=
# NEXT_PUBLIC_GEMINI_API_KEY_4=
# NEXT_PUBLIC_GEMINI_API_KEY_5=

# ==========================================
# Email Notifications / SOS Alert (Optional)
# ==========================================
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=
